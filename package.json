{
  "name": "postcode",
  "version": "5.1.0",
  "description": "UK Postcode helper methods",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "esm/index.js",
  "engines": {
    "node": ">= 10.0.0"
  },
  "prettier": {
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@cablanchard/semantic-release": "~1.3.1",
    "@cablanchard/tsconfig": "2.0.0",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.3",
    "axios": "1.20.0",
    "chai": "6.2.2",
    "codecov": "~3.8.0",
    "eslint": "10.10.0",
    "mocha": "12.0.1",
    "nyc": "18.0.0",
    "prettier": "3.9.7",
    "semantic-release": "~17.4.0",
    "source-map-support": "0.5.21",
    "ts-node": "10.9.2",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "mocha": {
    "extension": [
      "js",
      "ts"
    ],
    "exit": true,
    "fullTrace": true,
    "require": [
      "ts-node/register",
      "source-map-support/register"
    ]
  },
  "files": [
    "dist",
    "esm",
    "example.js"
  ],
  "runkitExampleFilename": "example.js",
  "nyc": {
    "include": [
      "lib/**/*.ts",
      "generate/**/*.ts"
    ],
    "exclude": [
      "dist/*",
      "esm/*",
      "**/*.d.ts",
      "generate/index.ts"
    ],
    "extension": [
      ".ts",
      ".tsx"
    ],
    "require": [
      "ts-node/register"
    ],
    "reporter": [
      "text-summary",
      "html"
    ],
    "all": true
  },
  "scripts": {
    "semantic-release": "semantic-release --no-ci",
    "test": "npm run lint && NODE_ENV=test nyc mocha",
    "prepublishOnly": "npm run build",
    "lint": "eslint lib/**/*.ts",
    "docs": "typedoc",
    "build": "tsc && tsc --outDir esm -m ESNext",
    "coverage": "nyc report --reporter=text-lcov > coverage.lcov && codecov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ideal-postcodes/postcode.git"
  },
  "keywords": [
    "uk",
    "postcode",
    "validation",
    "parsing"
  ],
  "author": {
    "name": "Ideal Postcodes",
    "url": "https://ideal-postcodes.co.uk",
    "email": "support@ideal-postcodes.co.uk"
  },
  "license": "MIT",
  "release": {
    "extends": "@cablanchard/semantic-release/dist/npm"
  },
  "bugs": {
    "url": "https://github.com/ideal-postcodes/postcode/issues"
  }
}
